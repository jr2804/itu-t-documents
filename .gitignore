# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.coverage
coverage.xml
htmlcov/

# Documentation build output (zensical / mkdocs)
site/

# Rust build artifacts (maturin/other native builds)
target/

# Native extension binaries
*.so
*.dll
*.pyd
*.dylib

# Windows artifacts
*.exe
*.pdb
nul

# Logs
*.log

# Virtual environments
.venv
*.env
uv.lock

# Dev tools/MCP server data/dirs
/.config/chunkhound/db
.sisyphus
.config/memorygraph/memory.db
/.opencode

# temp folders
/.tmp
/tmp
/temp

# Copier answers (regenerated on update)
.copier-answers.yml


# Skills lock file
skills-lock.json

# Local tool / MCP / coding assistant directories
.repowise/
.grepai/
.mcp.json
opencode.json
opencode.jsonc
mcporter.json

.pi/
.codex/
.claude/
.cursor/
CLAUDE.md
