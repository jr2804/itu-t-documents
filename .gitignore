.opencode/

# .agents/ DOX files — track .md and history/, ignore everything else tools may drop
/.agents/*
!/.agents/*.md
!/.agents/history/
!/.agents/history/**
!/.agents/tools/
!/.agents/tools/**
# Implementation plans — mutable working artifacts, never committed
/.agents/plans/

# Local mise tool pins (for example node/bun) and dev-feature tools
mise.local.toml

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

.cache/